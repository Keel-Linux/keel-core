#!/bin/bash
# The system information block of the Keel message of the day, under the
# mark 00-keel-banner printed.
#
# Why here. It replaces 00-turnkey-sysinfo, which common
# (conf/turnkey.d/motd) writes and conf.d/main of this recipe removes.
# That file welcomed the operator a second time, to another distribution,
# and ended with a block telling them to initialise a backup service this
# project does not host (issue #6, decisions 0002 and 0014). The half of
# it worth keeping is the system information the turnkey-sysinfo command
# prints: the load, the memory, the processes, the swap, the usage of /
# and an address per interface. That command is called by the name it has
# today.
#
# Logic is in /usr/lib/keel/motd.sh (decision 0004); this file only
# collects the facts and prints what the library returns.

set -u

KEEL_MOTD_LIB="${KEEL_MOTD_LIB:-/usr/lib/keel/motd.sh}"

[ -r "$KEEL_MOTD_LIB" ] || exit 0
# shellcheck source=../../usr/lib/keel/motd.sh
. "$KEEL_MOTD_LIB"

if command -v "$KEEL_MOTD_SYSINFO_COMMAND" > /dev/null 2>&1; then
    "$KEEL_MOTD_SYSINFO_COMMAND" 2>/dev/null \
        | keel_motd_system_block \
        | keel_motd_indent "$KEEL_MOTD_INDENT"
    echo
fi

keel_motd_backup_lines | keel_motd_indent "$KEEL_MOTD_INDENT"
echo
