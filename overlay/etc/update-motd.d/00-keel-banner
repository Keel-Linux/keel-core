#!/bin/bash
# The Keel console banner, above the message of the day the appliance
# already prints.
#
# Why here. /etc/update-motd.d is a drop-in directory that pam_motd runs at
# every interactive login, over SSH and on the container console alike, and
# it is where common (conf/turnkey.d/motd) already writes the sysinfo, the
# first boot warning and the confconsole line. Adding one file named before
# those keeps every word upstream prints and puts the mark above it; no
# upstream file is edited and nothing is replaced. /etc/issue was not used:
# getty prints it before the login prompt, so the mark would scroll away
# with each failed attempt and would be printed twice on a console login.
# The other console, tty1 running confconsole from inithooks, never reaches
# pam_motd; the mark is added to the usage screen in the confconsole
# repository, from these same files in /etc/keel.
#
# Logic is in /usr/lib/keel/banner.sh (decision 0004); this file only
# collects the facts and prints what the library returns.

set -u

# Set while this script runs the drop-ins after it to measure them, so that
# one of them that runs this file again prints nothing and measures nothing.
[ -z "${KEEL_BANNER_MEASURING-}" ] || exit 0

KEEL_BANNER_LIB="${KEEL_BANNER_LIB:-/usr/lib/keel/banner.sh}"
# The appliance version: /etc/turnkey_version, written by turnkey.mk of
# common at build time and read by inithooks (firstboot.d/29tagid). There is
# no Keel equivalent yet, nothing writes one, and inventing a second file
# here would leave it empty on every image built today; the path is a
# variable so the day the build writes /etc/keel_version it is one line.
KEEL_VERSION_FILE="${KEEL_VERSION_FILE:-/etc/turnkey_version}"
# confconsole's convention for a name other than the appliance name.
KEEL_APPNAME_FILE="${KEEL_APPNAME_FILE:-/etc/appname}"

# The system locale, read when the environment names none: pam_motd runs
# the drop-ins under "env -i", so on a login the environment is empty.
KEEL_LOCALE_FILE="${KEEL_LOCALE_FILE:-/etc/default/locale}"

# What pam_motd prints below this banner, measured so the mark leaves room
# for it (screenshots 112 to 115): the drop-ins of this directory named
# after this file, then the static /etc/motd (the "noupdate" line of
# /etc/pam.d/login and sshd). Each drop-in is run once more for that, and
# one that hangs is cut after KEEL_MOTD_TIMEOUT seconds.
KEEL_MOTD_DIR="${KEEL_MOTD_DIR:-/etc/update-motd.d}"
KEEL_MOTD_FILE="${KEEL_MOTD_FILE:-/etc/motd}"
KEEL_MOTD_TIMEOUT="${KEEL_MOTD_TIMEOUT:-5}"

# The lines of confconsole's usage screen. Each layer of the appliance
# chain installs its own over its base's, and a "Web:" line is how one
# says it serves the web (Keel Web and the applications on it do, Core
# does not), so the banner shows a Web line where the usage screen does.
KEEL_SERVICES_FILE="${KEEL_SERVICES_FILE:-/etc/confconsole/services.txt}"

[ -r "$KEEL_BANNER_LIB" ] || exit 0
# shellcheck source=../../usr/lib/keel/banner.sh
. "$KEEL_BANNER_LIB"

# The size: LINES and COLUMNS when a caller exports them, the controlling
# terminal when there is one, 24 by 80 otherwise.
tty_size=$(stty size 2>/dev/null < /dev/tty) || tty_size=""
read -r rows cols <<< "$(keel_banner_terminal_size "${LINES-}" \
    "${COLUMNS-}" "$tty_size")"

locale=$(keel_banner_effective_locale "${LC_ALL-}" "${LC_CTYPE-}" "${LANG-}")
if [ -z "$locale" ] && [ -r "$KEEL_LOCALE_FILE" ]; then
    locale=$(keel_banner_locale_of_file < "$KEEL_LOCALE_FILE")
fi
charset=$(keel_banner_charset "$locale")

version_string=""
if [ -r "$KEEL_VERSION_FILE" ]; then
    read -r version_string < "$KEEL_VERSION_FILE" || true
fi
app=$(keel_banner_app_name "$version_string") || app=$(hostname)
version=$(keel_banner_version "$version_string") || version=""

if [ -r "$KEEL_APPNAME_FILE" ]; then
    # read fails on a last line with no newline although it has read it,
    # so the name is kept whenever one was read.
    read -r name < "$KEEL_APPNAME_FILE" || [ -n "$name" ]
else
    name="Keel Linux $app"
fi

addresses=()
if address=$(ip -6 addr show scope global 2>/dev/null | keel_banner_pick_ipv6)
then
    addresses+=("$address")
fi
if address=$(ip -4 addr show scope global 2>/dev/null | keel_banner_pick_ipv4)
then
    addresses+=("$address")
fi

if [ -r "$KEEL_SERVICES_FILE" ]; then
    KEEL_BANNER_WEB=$(keel_banner_web_scheme < "$KEEL_SERVICES_FILE") \
        || KEEL_BANNER_WEB=""
fi

# rest_of_motd: the text pam_motd prints after this drop-in. The drop-ins
# are listed the way pam_motd runs them, "run-parts --lsbsysinit", which
# also takes the LSB hierarchical names a plain run-parts skips.
rest_of_motd() {
    local script
    run-parts --lsbsysinit --test "$KEEL_MOTD_DIR" 2>/dev/null \
        | keel_banner_after "$(basename "$0")" \
        | while IFS= read -r script; do
            KEEL_BANNER_MEASURING=1 timeout "$KEEL_MOTD_TIMEOUT" \
                "$script" < /dev/null 2>/dev/null || :
        done
    if [ -r "$KEEL_MOTD_FILE" ]; then
        cat "$KEEL_MOTD_FILE"
    fi
}

# and the blank line this drop-in ends with
below=$(rest_of_motd | keel_banner_text_rows "$cols")
KEEL_BANNER_BELOW_ROWS=$((below + 1))

keel_banner_render "$rows" "$cols" "$charset" "$name" "$version" \
    "${addresses[@]}"
echo
